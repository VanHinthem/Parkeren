# The project name must be different from the production deployment.
COMPOSE_PROJECT_NAME=parkeren-dev-example
PARKEREN_DEV_IMAGE_TAG=dev

PARKEREN_DB_PASSWORD=REPLACE_WITH_DEVELOPMENT_DATABASE_PASSWORD
PARKEREN_NOTIFICATION_RETENTION_DAYS=90
PARKEREN_APP_PORT=5080
PARKEREN_TWOPARK_MOCK_PORT=5081

# Optional Web Push configuration
PARKEREN_WEBPUSH_SUBJECT=
PARKEREN_WEBPUSH_PUBLIC_KEY=
PARKEREN_WEBPUSH_PRIVATE_KEY=

# Only needed when bootstrapping the first administrator in the dev database.
PARKEREN_BOOTSTRAP_ADMIN_USERNAME=
PARKEREN_BOOTSTRAP_ADMIN_PIN=