# Copy to .env in this directory. Do not commit real secrets.
COMPOSE_PROJECT_NAME=parkeren-acc
PARKEREN_APP_PORT=5082
# Use acc for latest accepted develop build, or acc-<commit-sha> to pin.
PARKEREN_ACC_IMAGE_TAG=acc
PARKEREN_DB_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
PARKEREN_NOTIFICATION_RETENTION_DAYS=90
PARKEREN_WEBPUSH_SUBJECT=
PARKEREN_WEBPUSH_PUBLIC_KEY=
PARKEREN_WEBPUSH_PRIVATE_KEY=
PARKEREN_BOOTSTRAP_ADMIN_USERNAME=
PARKEREN_BOOTSTRAP_ADMIN_PIN=
