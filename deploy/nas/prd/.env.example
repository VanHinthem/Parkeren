# Replace these placeholders on the NAS. Do not commit the populated file.
COMPOSE_PROJECT_NAME=replace-with-existing-production-project-name
PARKEREN_APP_IMAGE=ghcr.io/vanhinthem/parkeren-app:replace-with-release-tag-or-sha
PARKEREN_APP_PORT=5080

PARKEREN_DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
PARKEREN_TWOPARK_EMAIL=REPLACE_WITH_TWOPARK_EMAIL
PARKEREN_TWOPARK_PASSWORD=REPLACE_WITH_TWOPARK_PASSWORD
PARKEREN_NOTIFICATION_RETENTION_DAYS=90

# Optional browser push. Leave all three empty to disable it.
# Generate a matching key pair as described in deploy/examples/README.md.
# Subject is usually mailto:you@example.com; the private key is a secret.
PARKEREN_WEBPUSH_SUBJECT=
PARKEREN_WEBPUSH_PUBLIC_KEY=
PARKEREN_WEBPUSH_PRIVATE_KEY=

# Only needed when bootstrapping the first administrator in a new database.
PARKEREN_BOOTSTRAP_ADMIN_USERNAME=
PARKEREN_BOOTSTRAP_ADMIN_PIN=