PARKEREN_DB_PASSWORD=change-me
PARKEREN_NOTIFICATION_RETENTION_DAYS=90

# Web Push (VAPID). Genereer per omgeving een keypair en commit echte keys nooit.
PARKEREN_WEBPUSH_SUBJECT=mailto:admin@example.com
PARKEREN_WEBPUSH_PUBLIC_KEY=
PARKEREN_WEBPUSH_PRIVATE_KEY=
# Alleen nodig bij de allereerste start van een lege database.
# Verwijder deze waarden uit je echte .env nadat de eerste beheerder is aangemaakt.
PARKEREN_BOOTSTRAP_ADMIN_USERNAME=admin
PARKEREN_BOOTSTRAP_ADMIN_PIN=123456

# Alleen nodig voor de development-only read-only test tegen de echte 2Park-provider.
# Zet echte waarden uitsluitend in .env; commit ze nooit.
PARKEREN_TWOPARK_EMAIL=
PARKEREN_TWOPARK_PASSWORD=
